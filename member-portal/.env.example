DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ileap_member_portal"
JWT_SECRET="replace-with-a-long-random-secret"
CLIENT_ORIGIN="http://localhost:5173"
# Comma-separated list used by the Render API when the frontend and backend are on different domains.
CLIENT_ORIGINS="http://localhost:5173,https://member.ileapclub.com,https://members.ileapclub.com"
# Used by the Cloudflare Pages frontend build. Leave empty locally to keep relative /api requests.
VITE_API_BASE_URL=""
PORT=4000

# Local/demo seed settings. Do not reuse these values for production users.
SEED_ADMIN_EMAIL="admin@ileapclub.com"
SEED_DEMO_PASSWORD="ChangeMe123!"
