generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CENTER_DIRECTOR
  FACILITATOR
  PARENT
  STUDENT
}

enum PaymentStatus {
  PAID
  NOT_PAID
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role
  isActive     Boolean  @default(true)
  sessionVersion Int    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parentStudents StudentParent[] @relation("ParentUser")
  studentProfile  Student?
  facilitator     ClubFacilitator[]
  centreFacilitator CentreFacilitator[]
  uploadedBandDocuments BandDocument[] @relation("BandDocumentUploadedBy")
  createdResourceLinks ResourceLink[] @relation("ResourceLinkCreatedBy")
  updatedResourceLinks ResourceLink[] @relation("ResourceLinkUpdatedBy")
  createdNotices Notice[] @relation("NoticeCreatedBy")
  createdMemberFeedback MemberFeedback[] @relation("MemberFeedbackCreatedBy")
  updatedMonthlyMemberPayments MonthlyMemberPayment[] @relation("MonthlyMemberPaymentUpdatedBy")
  learningReflectionResponses MemberLearningReflection[] @relation("LearningReflectionRespondedBy")
  awardedMemberPoints MemberPointTransaction[] @relation("MemberPointAwardedBy")
  updatedMemberProgressNotes MemberProgressNote[] @relation("MemberProgressNoteUpdatedBy")
  centerDirectorAssignments CenterDirectorAssignment[] @relation("CenterDirectorUser")
  assignedCenterDirectors CenterDirectorAssignment[] @relation("CenterDirectorAssignedBy")
}

model PasswordResetAudit {
  id            String   @id @default(cuid())
  targetUserId  String
  resetByUserId String
  resetAt       DateTime @default(now())

  @@index([targetUserId, resetAt])
  @@index([resetByUserId, resetAt])
}

model Centre {
  id        String   @id @default(cuid())
  name      String
  province  String
  city      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clubs Club[]
  facilitators CentreFacilitator[]
  centerDirectors CenterDirectorAssignment[]
  resourceLinks ResourceLink[]
}

model CenterDirectorAssignment {
  id                String   @id @default(cuid())
  userId            String
  centreId          String
  assignedByAdminId String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User   @relation("CenterDirectorUser", fields: [userId], references: [id], onDelete: Cascade)
  centre          Centre @relation(fields: [centreId], references: [id], onDelete: Cascade)
  assignedByAdmin User   @relation("CenterDirectorAssignedBy", fields: [assignedByAdminId], references: [id])

  @@unique([userId, centreId])
  @@index([centreId, isActive])
  @@index([assignedByAdminId])
}

model Club {
  id        String   @id @default(cuid())
  centreId  String
  name      String
  program   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  centre       Centre            @relation(fields: [centreId], references: [id])
  studentMemberships StudentClubMembership[]
  facilitators ClubFacilitator[]
  meetings     Meeting[]
  bandDocuments BandDocument[]
  notices      Notice[]
  memberFeedback MemberFeedback[]
}

model Student {
  id        String   @id @default(cuid())
  userId    String   @unique
  grade     String
  programLevel String?
  bandLevel String   @default("White")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id])
  parents StudentParent[]
  clubMemberships StudentClubMembership[]
  roleSlots MeetingRoleSlot[]
  attendance MeetingAttendance[]
  roleScores MeetingRoleScore[]
  meetingFeedbacks StudentMeetingFeedback[]
  memberFeedback MemberFeedback[]
  requirementProgress StudentRequirementProgress[]
  monthlyPayments MonthlyMemberPayment[]
  learningReflections MemberLearningReflection[]
  pointTransactions MemberPointTransaction[]
  progressNote MemberProgressNote?
}

model StudentClubMembership {
  id        String   @id @default(cuid())
  studentId String
  clubId    String
  status    String   @default("ACTIVE")
  startDate DateTime @default(now())
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  club    Club    @relation(fields: [clubId], references: [id])

  @@unique([studentId, clubId])
  @@index([clubId])
  @@index([studentId])
}

model StudentParent {
  id        String   @id @default(cuid())
  parentId  String
  studentId String
  createdAt DateTime @default(now())

  parent  User    @relation("ParentUser", fields: [parentId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([parentId, studentId])
}

model ClubFacilitator {
  id            String   @id @default(cuid())
  clubId        String
  facilitatorId String
  createdAt     DateTime @default(now())

  club        Club @relation(fields: [clubId], references: [id])
  facilitator User @relation(fields: [facilitatorId], references: [id])

  @@unique([clubId, facilitatorId])
}

model CentreFacilitator {
  id            String   @id @default(cuid())
  centreId      String
  facilitatorId String
  createdAt     DateTime @default(now())

  centre      Centre @relation(fields: [centreId], references: [id])
  facilitator User   @relation(fields: [facilitatorId], references: [id])

  @@unique([centreId, facilitatorId])
}

model RoleDefinition {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  category    String   @default("Speaking Role")
  programLevel String?
  level       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  meetingSlots MeetingRoleSlot[]

  @@index([programLevel])
  @@index([isActive])
}

model Meeting {
  id           String   @id @default(cuid())
  clubId       String
  title        String
  templateType String
  meetingDate  DateTime
  startTime    String
  location     String?
  isRoleLocked Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  club      Club              @relation(fields: [clubId], references: [id])
  roleSlots MeetingRoleSlot[]
  attendance MeetingAttendance[]
  roleScores MeetingRoleScore[]
  studentFeedbacks StudentMeetingFeedback[]
  learningReflections MemberLearningReflection[]
}

model MeetingRoleSlot {
  id               String   @id @default(cuid())
  meetingId        String
  roleDefinitionId String
  slotLabel        String
  sortOrder        Int      @default(0)
  assignedStudentId String?
  assignedByUserId String?
  assignedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  meeting        Meeting        @relation(fields: [meetingId], references: [id])
  roleDefinition RoleDefinition @relation(fields: [roleDefinitionId], references: [id])
  assignedStudent Student?      @relation(fields: [assignedStudentId], references: [id])
  score MeetingRoleScore?

  @@index([meetingId])
  @@unique([meetingId, sortOrder])
}

model MeetingAttendance {
  id             String   @id @default(cuid())
  meetingId      String
  studentId      String
  status         String   @default("PRESENT")
  notes          String?
  markedByUserId String?
  markedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([meetingId, studentId])
}

model MeetingRoleScore {
  id             String   @id @default(cuid())
  meetingId      String
  roleSlotId     String   @unique
  studentId      String
  score          Int
  feedback       String?
  scoredByUserId String?
  scoredAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  meeting  Meeting         @relation(fields: [meetingId], references: [id])
  roleSlot MeetingRoleSlot @relation(fields: [roleSlotId], references: [id])
  student  Student         @relation(fields: [studentId], references: [id])

  @@index([meetingId])
  @@index([studentId])
}

model StudentMeetingFeedback {
  id             String   @id @default(cuid())
  meetingId      String
  studentId      String
  roleSlotId     String?
  score          Int
  feedback       String?
  scoredByUserId String?
  scoredAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  meeting  Meeting @relation(fields: [meetingId], references: [id])
  student  Student @relation(fields: [studentId], references: [id])

  @@unique([meetingId, studentId])
  @@index([meetingId])
  @@index([studentId])
  @@index([roleSlotId])
}

model MemberFeedback {
  id              String   @id @default(cuid())
  studentId       String
  clubId          String
  feedback        String
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student   Student @relation(fields: [studentId], references: [id])
  club      Club    @relation(fields: [clubId], references: [id])
  createdBy User?   @relation("MemberFeedbackCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([clubId, createdAt])
  @@index([createdByUserId])
}

model MonthlyMemberPayment {
  id               String        @id @default(cuid())
  studentId        String
  paymentMonth     DateTime      @db.Date
  status           PaymentStatus @default(NOT_PAID)
  updatedByAdminId String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  student        Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  updatedByAdmin User    @relation("MonthlyMemberPaymentUpdatedBy", fields: [updatedByAdminId], references: [id])

  @@unique([studentId, paymentMonth])
  @@index([paymentMonth, status])
  @@index([updatedByAdminId])
}

model BandRequirement {
  id          String   @id @default(cuid())
  programLevel String  @default("SENIOR")
  bandLevel   String
  bandOrder   Int      @default(0)
  name        String
  description String
  requirementType String
  targetCount Int      @default(1)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  progress StudentRequirementProgress[]
  resourceLinks ResourceLink[]
  learningReflections MemberLearningReflection[]

  @@unique([programLevel, bandLevel, name])
  @@index([programLevel])
  @@index([bandLevel])
}

model MemberLearningReflection {
  id                             String   @id @default(cuid())
  studentId                      String
  meetingId                      String?
  reflectionDate                 DateTime @default(now()) @db.Date
  whatLearned                    String   @db.VarChar(200)
  whatDidWell                    String   @db.VarChar(200)
  whatToImprove                  String   @db.VarChar(200)
  bandRequirementId              String?
  thinksBandRequirementCompleted Boolean  @default(false)
  facilitatorResponse            String?  @db.VarChar(300)
  respondedByUserId              String?
  respondedAt                    DateTime?
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  meeting         Meeting?         @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  bandRequirement BandRequirement? @relation(fields: [bandRequirementId], references: [id], onDelete: SetNull)
  respondedBy     User?            @relation("LearningReflectionRespondedBy", fields: [respondedByUserId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([meetingId])
  @@index([bandRequirementId])
  @@index([respondedByUserId])
}

model MemberPointTransaction {
  id              String   @id @default(cuid())
  studentId       String
  pointsDelta     Int
  reason          String?  @db.VarChar(500)
  awardedByUserId String?
  awardedAt       DateTime @default(now())
  createdAt       DateTime @default(now())

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  awardedBy User?   @relation("MemberPointAwardedBy", fields: [awardedByUserId], references: [id], onDelete: SetNull)

  @@index([studentId, awardedAt])
  @@index([awardedByUserId])
}

model MemberProgressNote {
  id              String   @id @default(cuid())
  studentId       String   @unique
  note            String   @db.VarChar(1000)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation("MemberProgressNoteUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}

model ResourceLink {
  id            String   @id @default(cuid())
  title         String
  explanation   String
  youtubeUrl    String?
  documentUrl   String?
  programLevel  String?
  bandLevel     String?
  bandOrder     Int?
  roleKey       String?
  requirementId String?
  centreId      String?
  category      String
  status        String   @default("ACTIVE")
  createdById   String
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requirement BandRequirement? @relation(fields: [requirementId], references: [id])
  centre      Centre?          @relation(fields: [centreId], references: [id])
  createdBy   User             @relation("ResourceLinkCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?            @relation("ResourceLinkUpdatedBy", fields: [updatedById], references: [id])

  @@index([status])
  @@index([roleKey])
  @@index([programLevel, bandOrder])
  @@index([requirementId])
  @@index([centreId])
  @@index([category])
}

model StudentRequirementProgress {
  id            String   @id @default(cuid())
  studentId     String
  requirementId String
  currentCount  Int      @default(0)
  isCompleted   Boolean  @default(false)
  completedAt   DateTime?
  notes         String?
  updatedByUserId String?
  facilitatorSignedOffByUserId String?
  facilitatorSignedOffAt DateTime?
  adminOverrideByUserId String?
  adminOverrideAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student     Student         @relation(fields: [studentId], references: [id])
  requirement BandRequirement @relation(fields: [requirementId], references: [id])

  @@unique([studentId, requirementId])
  @@index([studentId])
}

model BandDocument {
  id           String   @id @default(cuid())
  title        String
  description  String?
  fileName     String
  fileUrl      String
  programLevel String
  bandLevel    String
  bandOrder    Int
  sessionModule String?
  clubId       String?
  category     String
  uploadedById String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  club       Club? @relation(fields: [clubId], references: [id])
  uploadedBy User  @relation("BandDocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([programLevel, bandOrder])
  @@index([clubId])
  @@index([status])
  @@index([category])
}

model Notice {
  id              String   @id @default(cuid())
  title           String
  message         String
  clubId          String?
  createdByUserId String
  status          String   @default("ACTIVE")
  expiresAt       DateTime?
  isPinned        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  club      Club? @relation(fields: [clubId], references: [id])
  createdBy User  @relation("NoticeCreatedBy", fields: [createdByUserId], references: [id])

  @@index([clubId, status])
  @@index([status, expiresAt])
  @@index([isPinned, createdAt])
}
